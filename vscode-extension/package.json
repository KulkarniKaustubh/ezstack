{
  "name": "ezstack",
  "displayName": "ezstack",
  "description": "Manage stacked pull requests with git worktrees",
  "version": "4.6.3",
  "icon": "resources/icon.png",
  "publisher": "kaustubh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KulkarniKaustubh/ezstack.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ezstack",
          "title": "ezstack",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ezstack": [
        {
          "id": "ezstackStacks",
          "name": "Stacks"
        },
        {
          "id": "ezstackFiles",
          "name": "Files"
        }
      ]
    },
    "commands": [
      {
        "command": "ezstack.refresh",
        "title": "Refresh",
        "category": "ezstack",
        "icon": "$(refresh)"
      },
      {
        "command": "ezstack.expandAll",
        "title": "Expand All",
        "category": "ezstack",
        "icon": "$(expand-all)"
      },
      {
        "command": "ezstack.newBranch",
        "title": "New Branch",
        "category": "ezstack",
        "icon": "$(add)"
      },
      {
        "command": "ezstack.sync",
        "title": "Sync",
        "category": "ezstack",
        "icon": "$(sync)"
      },
      {
        "command": "ezstack.syncBranch",
        "title": "Sync Branch",
        "category": "ezstack",
        "icon": "$(sync)"
      },
      {
        "command": "ezstack.push",
        "title": "Push Branch",
        "category": "ezstack"
      },
      {
        "command": "ezstack.pushStack",
        "title": "Push Stack",
        "category": "ezstack"
      },
      {
        "command": "ezstack.prCreate",
        "title": "Create PR",
        "category": "ezstack"
      },
      {
        "command": "ezstack.prUpdate",
        "title": "Update PR",
        "category": "ezstack"
      },
      {
        "command": "ezstack.prMerge",
        "title": "Merge PR",
        "category": "ezstack"
      },
      {
        "command": "ezstack.prDraft",
        "title": "Toggle PR Draft",
        "category": "ezstack"
      },
      {
        "command": "ezstack.prStack",
        "title": "Update Stack Info in PRs",
        "category": "ezstack"
      },
      {
        "command": "ezstack.goto",
        "title": "Go to Branch",
        "category": "ezstack"
      },
      {
        "command": "ezstack.up",
        "title": "Go to Parent Branch",
        "category": "ezstack"
      },
      {
        "command": "ezstack.down",
        "title": "Go to Child Branch",
        "category": "ezstack"
      },
      {
        "command": "ezstack.delete",
        "title": "Delete Branch",
        "category": "ezstack",
        "icon": "$(trash)"
      },
      {
        "command": "ezstack.reparent",
        "title": "Reparent Branch",
        "category": "ezstack"
      },
      {
        "command": "ezstack.openPR",
        "title": "Open PR in Browser",
        "category": "ezstack",
        "icon": "$(link-external)"
      },
      {
        "command": "ezstack.openWorktree",
        "title": "Open in New Window",
        "category": "ezstack",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "ezstack.renameStack",
        "title": "Rename Stack",
        "category": "ezstack",
        "icon": "$(edit)"
      },
      {
        "command": "ezstack.toggleFavorite",
        "title": "Toggle Favorite",
        "category": "ezstack",
        "icon": "$(star)"
      },
      {
        "command": "ezstack.filterFavorites",
        "title": "Filter by Favorites",
        "category": "ezstack",
        "icon": "$(star-empty)"
      },
      {
        "command": "ezstack.showAll",
        "title": "Show All Files",
        "category": "ezstack",
        "icon": "$(star-full)"
      },
      {
        "command": "ezstack.copyPath",
        "title": "Copy Path",
        "category": "ezstack"
      },
      {
        "command": "ezstack.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "ezstack"
      },
      {
        "command": "ezstack.revealInFinder",
        "title": "Reveal in Finder",
        "category": "ezstack"
      },
      {
        "command": "ezstack.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "ezstack"
      },
      {
        "command": "ezstack.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "ezstack"
      },
      {
        "command": "ezstack.openBranchTerminal",
        "title": "Open in Terminal",
        "category": "ezstack"
      },
      {
        "command": "ezstack.gitPull",
        "title": "Fetch & Pull",
        "category": "ezstack"
      },
      {
        "command": "ezstack.openAgent",
        "title": "Open Agent",
        "category": "ezstack",
        "icon": "$(hubot)"
      },
      {
        "command": "ezstack.openAgentFeature",
        "title": "Build Feature with Agent",
        "category": "ezstack",
        "icon": "$(wand)"
      },
      {
        "command": "ezstack.editAgentPrompt",
        "title": "Edit Agent Prompt",
        "category": "ezstack",
        "icon": "$(edit)"
      },
      {
        "command": "ezstack.openInNextPR",
        "title": "Open File in Next PR",
        "category": "ezstack"
      },
      {
        "command": "ezstack.openInPreviousPR",
        "title": "Open File in Previous PR",
        "category": "ezstack"
      },
      {
        "command": "ezstack.compareWithPreviousPR",
        "title": "Compare File with Previous PR",
        "category": "ezstack"
      },
      {
        "command": "ezstack.doctor",
        "title": "Doctor (Health Check)",
        "category": "ezstack",
        "icon": "$(stethoscope)"
      },
      {
        "command": "ezstack.syncStackOptions",
        "title": "Sync Stack with Options...",
        "category": "ezstack"
      },
      {
        "command": "ezstack.prDraftAll",
        "title": "Create Draft PRs for Stack",
        "category": "ezstack"
      },
      {
        "command": "ezstack.deleteCascade",
        "title": "Delete Branch and Descendants (Cascade)",
        "category": "ezstack",
        "icon": "$(trash)"
      },
      {
        "command": "ezstack.configExport",
        "title": "Export Config...",
        "category": "ezstack"
      },
      {
        "command": "ezstack.configImport",
        "title": "Import Config...",
        "category": "ezstack"
      },
      {
        "command": "ezstack.pushWithOptions",
        "title": "Push with Options...",
        "category": "ezstack"
      },
      {
        "command": "ezstack.openAgentWithOptions",
        "title": "Open Agent with Options...",
        "category": "ezstack",
        "icon": "$(hubot)"
      }
    ],
    "keybindings": [
      {
        "command": "ezstack.openInNextPR",
        "key": "cmd+alt+down",
        "when": "editorTextFocus"
      },
      {
        "command": "ezstack.openInPreviousPR",
        "key": "cmd+alt+up",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ezstack.filterFavorites",
          "when": "view == ezstackFiles && !ezstack.filterByFavorites",
          "group": "navigation"
        },
        {
          "command": "ezstack.showAll",
          "when": "view == ezstackFiles && ezstack.filterByFavorites",
          "group": "navigation"
        },
        {
          "command": "ezstack.refresh",
          "when": "view == ezstackStacks",
          "group": "navigation"
        },
        {
          "command": "ezstack.expandAll",
          "when": "view == ezstackStacks",
          "group": "navigation"
        },
        {
          "command": "ezstack.newBranch",
          "when": "view == ezstackStacks",
          "group": "navigation"
        },
        {
          "command": "ezstack.sync",
          "when": "view == ezstackStacks",
          "group": "navigation"
        },
        {
          "command": "ezstack.openAgentFeature",
          "when": "view == ezstackStacks",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "ezstack.openInNextPR",
          "when": "ezstack.hasNextPR",
          "group": "ezstack@1"
        },
        {
          "command": "ezstack.openInPreviousPR",
          "when": "ezstack.hasPreviousPR",
          "group": "ezstack@2"
        },
        {
          "command": "ezstack.compareWithPreviousPR",
          "when": "ezstack.hasPreviousPR",
          "group": "ezstack@3"
        }
      ],
      "explorer/context": [
        {
          "command": "ezstack.openInNextPR",
          "when": "ezstack.hasNextPR",
          "group": "ezstack@1"
        },
        {
          "command": "ezstack.openInPreviousPR",
          "when": "ezstack.hasPreviousPR",
          "group": "ezstack@2"
        },
        {
          "command": "ezstack.compareWithPreviousPR",
          "when": "ezstack.hasPreviousPR",
          "group": "ezstack@3"
        }
      ],
      "view/item/context": [
        {
          "command": "ezstack.toggleFavorite",
          "when": "view == ezstackFiles && viewItem =~ /^(folder|file|favoriteFolder|favoriteFile)$/",
          "group": "inline"
        },
        {
          "command": "ezstack.copyPath",
          "when": "view == ezstackFiles && viewItem =~ /^(folder|file|favoriteFolder|favoriteFile)$/",
          "group": "1_path@1"
        },
        {
          "command": "ezstack.copyRelativePath",
          "when": "view == ezstackFiles && viewItem =~ /^(folder|file|favoriteFolder|favoriteFile)$/",
          "group": "1_path@2"
        },
        {
          "command": "ezstack.revealInFinder",
          "when": "view == ezstackFiles && viewItem =~ /^(folder|file|favoriteFolder|favoriteFile)$/",
          "group": "2_system@1"
        },
        {
          "command": "ezstack.openInTerminal",
          "when": "view == ezstackFiles && viewItem =~ /^(folder|file|favoriteFolder|favoriteFile)$/",
          "group": "2_system@2"
        },
        {
          "command": "ezstack.revealInExplorer",
          "when": "view == ezstackFiles && viewItem =~ /^(folder|file|favoriteFolder|favoriteFile)$/",
          "group": "2_system@3"
        },
        {
          "command": "ezstack.openInNextPR",
          "when": "view == ezstackFiles && viewItem =~ /^(file|favoriteFile)$/ && ezstack.hasNextPR",
          "group": "3_stack@1"
        },
        {
          "command": "ezstack.openInPreviousPR",
          "when": "view == ezstackFiles && viewItem =~ /^(file|favoriteFile)$/ && ezstack.hasPreviousPR",
          "group": "3_stack@2"
        },
        {
          "command": "ezstack.compareWithPreviousPR",
          "when": "view == ezstackFiles && viewItem =~ /^(file|favoriteFile)$/ && ezstack.hasPreviousPR",
          "group": "3_stack@3"
        },
        {
          "command": "ezstack.toggleFavorite",
          "when": "view == ezstackFiles && viewItem =~ /^(folder|file|favoriteFolder|favoriteFile)$/",
          "group": "4_favorite@1"
        },
        {
          "command": "ezstack.renameStack",
          "when": "view == ezstackStacks && viewItem == stack",
          "group": "inline"
        },
        {
          "command": "ezstack.openWorktree",
          "when": "view == ezstackStacks && viewItem =~ /^branch/",
          "group": "inline"
        },
        {
          "command": "ezstack.openPR",
          "when": "view == ezstackStacks && viewItem == branchWithPR",
          "group": "inline"
        },
        {
          "command": "ezstack.openBranchTerminal",
          "when": "view == ezstackStacks && viewItem =~ /^(branch|rootRepo)/",
          "group": "0_terminal@1"
        },
        {
          "command": "ezstack.newBranch",
          "when": "view == ezstackStacks && viewItem == rootRepo",
          "group": "1_actions@1"
        },
        {
          "command": "ezstack.gitPull",
          "when": "view == ezstackStacks && viewItem == rootRepo",
          "group": "1_actions@2"
        },
        {
          "command": "ezstack.sync",
          "when": "view == ezstackStacks && viewItem == rootRepo",
          "group": "1_actions@3"
        },
        {
          "command": "ezstack.syncBranch",
          "when": "view == ezstackStacks && viewItem =~ /^branch/",
          "group": "1_actions@0"
        },
        {
          "command": "ezstack.push",
          "when": "view == ezstackStacks && viewItem =~ /^branch/",
          "group": "1_actions@1"
        },
        {
          "command": "ezstack.prCreate",
          "when": "view == ezstackStacks && viewItem == branch",
          "group": "1_actions@2"
        },
        {
          "command": "ezstack.prUpdate",
          "when": "view == ezstackStacks && viewItem == branchWithPR",
          "group": "1_actions@2"
        },
        {
          "command": "ezstack.prMerge",
          "when": "view == ezstackStacks && viewItem == branchWithPR",
          "group": "1_actions@3"
        },
        {
          "command": "ezstack.prDraft",
          "when": "view == ezstackStacks && viewItem == branchWithPR",
          "group": "1_actions@4"
        },
        {
          "command": "ezstack.reparent",
          "when": "view == ezstackStacks && viewItem =~ /^branch/",
          "group": "2_modify@1"
        },
        {
          "command": "ezstack.delete",
          "when": "view == ezstackStacks && viewItem =~ /^branch/",
          "group": "2_modify@2"
        },
        {
          "command": "ezstack.renameStack",
          "when": "view == ezstackStacks && viewItem == stack",
          "group": "1_stack@1"
        },
        {
          "command": "ezstack.sync",
          "when": "view == ezstackStacks && viewItem == stack",
          "group": "1_stack@2"
        },
        {
          "command": "ezstack.newBranch",
          "when": "view == ezstackStacks && viewItem == stack",
          "group": "1_stack@3"
        },
        {
          "command": "ezstack.openAgent",
          "when": "view == ezstackStacks && viewItem == stack",
          "group": "2_agent@1"
        },
        {
          "command": "ezstack.openAgentFeature",
          "when": "view == ezstackStacks && viewItem == stack",
          "group": "2_agent@2"
        },
        {
          "command": "ezstack.editAgentPrompt",
          "when": "view == ezstackStacks && viewItem == stack",
          "group": "2_agent@3"
        },
        {
          "command": "ezstack.openAgent",
          "when": "view == ezstackStacks && viewItem =~ /^branch/",
          "group": "2_agent@1"
        }
      ]
    },
    "colors": [
      {
        "id": "ezstack.stack0",
        "description": "Color for stack group 0",
        "defaults": {
          "dark": "#4FC1FF",
          "light": "#0066CC"
        }
      },
      {
        "id": "ezstack.stack1",
        "description": "Color for stack group 1",
        "defaults": {
          "dark": "#C586C0",
          "light": "#AF00AF"
        }
      },
      {
        "id": "ezstack.stack2",
        "description": "Color for stack group 2",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#008060"
        }
      },
      {
        "id": "ezstack.stack3",
        "description": "Color for stack group 3",
        "defaults": {
          "dark": "#DCDCAA",
          "light": "#795E26"
        }
      },
      {
        "id": "ezstack.stack4",
        "description": "Color for stack group 4",
        "defaults": {
          "dark": "#CE9178",
          "light": "#A31515"
        }
      },
      {
        "id": "ezstack.stack5",
        "description": "Color for stack group 5",
        "defaults": {
          "dark": "#D7BA7D",
          "light": "#B5651D"
        }
      },
      {
        "id": "ezstack.stack6",
        "description": "Color for stack group 6",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080"
        }
      },
      {
        "id": "ezstack.stack7",
        "description": "Color for stack group 7",
        "defaults": {
          "dark": "#F48771",
          "light": "#CD3131"
        }
      }
    ],
    "configuration": {
      "title": "ezstack",
      "properties": {
        "ezstack.cliPath": {
          "type": "string",
          "default": "ezs",
          "description": "Path to the ezs CLI binary"
        },
        "ezstack.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh stack view when config changes"
        },
        "ezstack.ticketPattern": {
          "type": "string",
          "default": "",
          "description": "Regex pattern to extract ticket IDs from branch names (e.g. \"PROJ-\\d+\"). The first match is shown in the status bar and folder badges. Leave empty to disable."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src --ignore-pattern '**/__mocks__/**'",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
